+export function searchCourses(query: CourseQuery): CoursePage {
+	const keyword = query.q?.trim().toLowerCase() ?? '';
+	const tag = query.tag?.trim().toLowerCase();
+	// ponytail: linear scan suits twelve fixtures; use indexed persistence when the catalog grows.
+	const matches = courses.filter(
+		(course) =>
+			(!query.modality || course.modality === query.modality) &&
+			(!query.status || course.status === query.status) &&
+			(tag === undefined || course.tags.some((value) => value.toLowerCase() === tag)) &&
+			(!keyword || [course.title, course.summary, ...course.tags].some((value) => value.toLowerCase().includes(keyword))),
+	);
+	matches.sort((a, b) => compare(a[query.sort].toLowerCase(), b[query.sort].toLowerCase()) || compare(a.id, b.id));
+	const totalItems = matches.length;
+	const totalPages = Math.ceil(totalItems / query.pageSize);
+	const start = query.page > totalPages ? totalItems : (query.page - 1) * query.pageSize;
+	// Copy nested tags so consumers cannot change the shared fixtures.
+	const items = matches.slice(start, start + query.pageSize).map((course) => ({ ...course, tags: [...course.tags] }));
+	return { items, page: query.page, pageSize: query.pageSize, totalItems, totalPages };
+}
