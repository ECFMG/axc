{
	"name": "@apps/api",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"prebuild": "pnpm run lint",
		"build": "tsgo --build && tsgo --noEmit --project tsconfig.rolldown.json && rolldown -c rolldown.config.ts && pnpm run prepare:deploy && node scripts/zip-deploy.mjs",
		"typecheck": "tsgo --noEmit",
		"prepare:deploy": "cellix-prepare-func-deploy",
		"dev": "node scripts/dev.mjs",
		"watch": "tsgo --watch",
		"lint": "biome lint",
		"format": "biome format --write",
		"format:check": "biome format .",
		"clean": "rimraf dist deploy",
		"prestart": "node --experimental-strip-types scripts/sync-local-settings.ts",
		"start": "node --experimental-strip-types scripts/start-host.ts"
	},
	"dependencies": {
		"@axc/application-services": "workspace:*",
		"@axc/persistence": "workspace:*",
		"@axc/rest": "workspace:*",
		"@cellix/api-core": "workspace:*"
	},
	"devDependencies": {
		"@cellix/config-rolldown": "workspace:*",
		"@cellix/config-typescript": "workspace:*",
		"@cellix/local-dev": "workspace:*",
		"@types/node": "catalog:",
		"rimraf": "catalog:",
		"rolldown": "1.0.0-beta.55",
		"typescript": "catalog:"
	}
}
