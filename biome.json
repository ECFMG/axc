{
	"$schema": "https://biomejs.dev/schemas/2.4.10/schema.json",
	"extends": ["@cellix/lint/biome"],
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/mock-oidc.users.local.json",
			"!**/dist",
			"!**/build",
			"!**/.docusaurus",
			"!**/deploy",
			"!**/target",
			"!**/node_modules",
			"!**/coverage",
			"!**/.turbo",
			"!**/*.tsbuildinfo",
			"!**/generated.*",
			"!**/*.generated.*",
			"!**/graphql.schema.json"
		]
	},
	"css": { "parser": { "cssModules": true } },
	"overrides": [
		{
			"includes": ["build-pipeline/scripts/**/*.{c|m}js", "packages/cellix/local-dev/bin/**/*.mjs", "apps/docs/sidebars.ts", "apps/docs/docusaurus.config.ts"],
			"linter": { "rules": { "style": { "noCommonJs": "off" } } }
		},
		{
			"includes": ["tailwind.config.js", "craco.config.js"],
			"linter": {
				"enabled": false
			}
		}
	]
}
