{
	"name": "@cellix/generator",
	"version": "1.0.0",
	"description": "Generates a Cellix feature slice: domain, model, persistence, and application action",
	"private": true,
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"default": "./dist/src/index.js"
		}
	},
	"scripts": {
		"generate": "tsx src/cli.ts",
		"lint": "biome lint",
		"prebuild": "biome lint",
		"build": "tsgo --build",
		"typecheck": "tsgo --noEmit",
		"test": "vitest run",
		"clean": "rimraf dist tsconfig.tsbuildinfo"
	},
	"dependencies": {
		"@cellix/lint": "workspace:*"
	},
	"devDependencies": {
		"@cellix/config-typescript": "workspace:*",
		"@cellix/config-vitest": "workspace:*",
		"@types/node": "catalog:",
		"rimraf": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
