{
	"name": "@axc/rest",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"lint": "biome lint",
		"format": "biome format --write",
		"format:check": "biome format .",
		"prebuild": "pnpm run lint",
		"build": "tsgo --build",
		"typecheck": "tsgo --noEmit",
		"test": "vitest run --silent --reporter=dot",
		"watch": "tsgo --watch",
		"clean": "rimraf dist tsconfig.tsbuildinfo"
	},
	"dependencies": {
		"@axc/application-services": "workspace:*",
		"@azure/functions": "catalog:",
		"@marplex/hono-azurefunc-adapter": "1.0.1",
		"hono": "catalog:"
	},
	"devDependencies": {
		"@axc/persistence": "workspace:*",
		"@cellix/config-typescript": "workspace:*",
		"rimraf": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
