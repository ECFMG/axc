{
	"name": "@axc/domain",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"lint": "biome lint",
		"format": "biome format --write",
		"format:check": "biome format .",
		"prebuild": "pnpm run lint",
		"build": "tsgo --build",
		"typecheck": "tsgo --noEmit",
		"watch": "tsgo --watch",
		"test:arch": "vitest run --config vitest.arch.config.ts",
		"clean": "rimraf dist tsconfig.tsbuildinfo"
	},
	"dependencies": {
		"@cellix/domain-seedwork": "workspace:*"
	},
	"devDependencies": {
		"@axc-verification/archunit-tests": "workspace:*",
		"@cellix/archunit-tests": "workspace:*",
		"@cellix/config-typescript": "workspace:*",
		"@cellix/config-vitest": "workspace:*",
		"rimraf": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
