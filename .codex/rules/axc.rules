# Codex execpolicy rules for this repository (loaded when the project .codex
# directory is trusted). Goal: the verification loop runs without approval
# prompts, while dependency changes and hook bypasses are refused outright.
# Validate with: codex execpolicy check --rules .codex/rules/axc.rules -- pnpm run test

prefix_rule(pattern = ["pnpm", "run", "test"], decision = "allow")
prefix_rule(pattern = ["pnpm", "run", "test:arch"], decision = "allow")
prefix_rule(pattern = ["pnpm", "run", "test:acceptance"], decision = "allow")
prefix_rule(pattern = ["pnpm", "run", "typecheck"], decision = "allow")
prefix_rule(pattern = ["pnpm", "run", "build"], decision = "allow")
prefix_rule(pattern = ["pnpm", "run", "lint"], decision = "allow")
prefix_rule(pattern = ["pnpm", "run", "format"], decision = "allow")
prefix_rule(pattern = ["pnpm", "run", "format:check"], decision = "allow")
prefix_rule(pattern = ["pnpm", "run", "knip"], decision = "allow")
prefix_rule(pattern = ["pnpm", "run", "verify"], decision = "allow")
prefix_rule(pattern = ["pnpm", "exec", "biome"], decision = "allow")
prefix_rule(pattern = ["pnpm", "exec", "vitest", "run"], decision = "allow")
prefix_rule(pattern = ["pnpm", "exec", "tsgo"], decision = "allow")
prefix_rule(pattern = ["pnpm", "turbo", "run"], decision = "allow")
prefix_rule(pattern = ["pnpm", "install", "--offline"], decision = "allow")
prefix_rule(pattern = ["pnpm", "install", "--frozen-lockfile"], decision = "allow")
prefix_rule(pattern = ["pnpm", "--filter"], decision = "allow")
prefix_rule(pattern = ["node", "scripts/check-script-policy.mjs"], decision = "allow")

prefix_rule(pattern = ["git", "status"], decision = "allow")
prefix_rule(pattern = ["git", "diff"], decision = "allow")
prefix_rule(pattern = ["git", "log"], decision = "allow")
prefix_rule(pattern = ["git", "show"], decision = "allow")
prefix_rule(pattern = ["git", "add"], decision = "allow")
prefix_rule(pattern = ["git", "commit", "-m"], decision = "allow")
prefix_rule(pattern = ["git", "commit", "-am"], decision = "allow")
prefix_rule(pattern = ["git", "rev-parse"], decision = "allow")

prefix_rule(pattern = ["curl", "-s"], decision = "allow")
prefix_rule(pattern = ["curl", "-sS"], decision = "allow")
prefix_rule(pattern = ["curl", "-i"], decision = "allow")
prefix_rule(pattern = ["func", "start"], decision = "allow")
prefix_rule(pattern = ["mongosh"], decision = "allow")

prefix_rule(pattern = ["pnpm", "add"], decision = "forbidden")
prefix_rule(pattern = ["pnpm", "remove"], decision = "forbidden")
prefix_rule(pattern = ["pnpm", "update"], decision = "forbidden")
prefix_rule(pattern = ["pnpm", "up"], decision = "forbidden")
prefix_rule(pattern = ["pnpm", "dlx"], decision = "forbidden")
prefix_rule(pattern = ["npx"], decision = "forbidden")
prefix_rule(pattern = ["npm", "install"], decision = "forbidden")
prefix_rule(pattern = ["git", "commit", "--no-verify"], decision = "forbidden")
prefix_rule(pattern = ["git", "commit", "-n"], decision = "forbidden")
prefix_rule(pattern = ["git", "push"], decision = "forbidden")
prefix_rule(pattern = ["git", "reset", "--hard"], decision = "forbidden")
prefix_rule(pattern = ["git", "checkout", "-b"], decision = "forbidden")
