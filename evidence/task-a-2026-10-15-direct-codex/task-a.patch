+	readonly modality: 'online' | 'in-person' | 'hybrid';
+	readonly status: 'draft' | 'active' | 'retired';
+	readonly tags: readonly string[];
+	readonly createdAt: string;
+	readonly updatedAt: string;
+}
+
+export interface CoursePage {
+	items: Course[];
+	page: number;
+	pageSize: number;
+	totalItems: number;
