# Node 24 via nvm when available (soft: no nvm -> use whatever node is on PATH).
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
	. "$NVM_DIR/nvm.sh" >/dev/null 2>&1 && nvm use >/dev/null 2>&1 || true
fi

pnpm exec lint-staged --quiet

# Full gate; agent-friendly output: silent on success, excerpt + log path on failure.
VERIFY_LOG="${TMPDIR:-/tmp}/axc-verify-$(basename "$PWD").log"
if ! pnpm run verify >"$VERIFY_LOG" 2>&1; then
	# excerpt exits 0 when it finds no known failure pattern -> fall back to the tail
	node scripts/verify-excerpt.mjs "$VERIFY_LOG" && tail -n 30 "$VERIFY_LOG"
	echo "verify FAILED — full log: $VERIFY_LOG"
	exit 1
fi
